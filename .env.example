# =====================================================================
# SatQuery AI Environment Configuration
# =====================================================================

# 1. REMOTE GPU INFERENCE URL (For Laptop across Any Wi-Fi):
# If you are running on a laptop, paste the public HTTPS URL
# generated by running 'start_gpu_host.bat' on your desktop PC.
# Example: MODEL_SERVICE_URL=https://satquery-gpu-host.trycloudflare.com
MODEL_SERVICE_URL=

# 2. LOCAL GPU IN-PROCESS INFERENCE (For Desktop PC with RTX GPU):
# Leave MODEL_SERVICE_URL empty if running backend directly on your PC.

# 3. Network Settings
HOST=0.0.0.0
PORT=8000

# 4. TinyFish Web Agent Infrastructure
TINYFISH_API_KEY=your_tinyfish_api_key_here

